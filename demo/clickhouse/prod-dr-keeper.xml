<!-- Keeper on every prod and DR machine: one 6-node ensemble across both DCs. DR Keepers cannot lead.
     KEEPER_ID comes from docker-compose.yml. -->
<clickhouse>
  <keeper_server>
    <tcp_port>9181</tcp_port>
    <enable_ipv6>false</enable_ipv6>
    <server_id from_env="KEEPER_ID"/>
    <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
    <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
    <raft_configuration>
      <server><id>1</id><hostname>prod1</hostname><port>9234</port></server>
      <server><id>2</id><hostname>prod2</hostname><port>9234</port></server>
      <server><id>3</id><hostname>prod3</hostname><port>9234</port></server>
      <server><id>4</id><hostname>dr1</hostname><port>9234</port><can_become_leader>false</can_become_leader></server>
      <server><id>5</id><hostname>dr2</hostname><port>9234</port><can_become_leader>false</can_become_leader></server>
      <server><id>6</id><hostname>dr3</hostname><port>9234</port><can_become_leader>false</can_become_leader></server>
    </raft_configuration>
  </keeper_server>
  <macros><shard>01</shard><replica from_env="REPLICA"/></macros>
  <interserver_http_host from_env="REPLICA"/>
  <merge_workload>background</merge_workload>
  <mutation_workload>background</mutation_workload>
</clickhouse>
