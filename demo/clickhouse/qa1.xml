<!-- The qa1 target: 1 shard x 3 replicas with its own 3-node Keeper ensemble on the same machines. -->
<clickhouse>
  <keeper_server>
    <tcp_port>9181</tcp_port>
    <enable_ipv6>false</enable_ipv6>
    <server_id from_env="KEEPER_ID"/>
    <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
    <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
    <raft_configuration>
      <server><id>1</id><hostname>qa1-1</hostname><port>9234</port></server>
      <server><id>2</id><hostname>qa1-2</hostname><port>9234</port></server>
      <server><id>3</id><hostname>qa1-3</hostname><port>9234</port></server>
    </raft_configuration>
  </keeper_server>
  <zookeeper>
    <node><host>qa1-1</host><port>9181</port></node>
    <node><host>qa1-2</host><port>9181</port></node>
    <node><host>qa1-3</host><port>9181</port></node>
  </zookeeper>
  <macros><shard>01</shard><replica from_env="REPLICA"/></macros>
  <interserver_http_host from_env="REPLICA"/>
</clickhouse>
